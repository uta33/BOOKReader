{
  "name": "bookreader",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:all": "eas build --platform all",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx tests/unit/migration.test.mts && tsx tests/unit/progress.test.mts && tsx tests/unit/isbn.test.mts && tsx tests/unit/lookup.test.mts && tsx tests/unit/summary.test.mts",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-blur": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.10",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
