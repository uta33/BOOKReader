{
  "expo": {
    "name": "BOOKReader",
    "slug": "bookreader",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookreader",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uta33.bookreader",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.uta33.bookreader",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "本のバーコード（JANコード）を読み取るためにカメラを使います。",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9a91c937-2890-431c-a583-30ed11eb9fd3"
      }
    }
  }
}
