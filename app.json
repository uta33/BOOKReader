{
  "expo": {
    "name": "READING NOTE",
    "slug": "bookreader",
    "version": "1.9.0",
    "icon": "./web/public/icon-reading-note-1024.png",
    "orientation": "portrait",
    "scheme": "bookreader",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uta33.bookreader",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.uta33.bookreader",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./web/public/icon-reading-note-foreground.png",
        "monochromeImage": "./web/public/icon-reading-note-monochrome.png",
        "backgroundColor": "#F3F1E8"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "読書ノートへ図・グラフ・写真を添付するために画像を選びます。",
          "cameraPermission": "本の図・グラフ・写真を読書ノートへ添付するためにカメラを使います。",
          "microphonePermission": "抜き書きやコメントを音声で入力するためにマイクを使います。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "本のバーコード（JANコード）を読み取るためにカメラを使います。",
          "microphonePermission": "抜き書きやコメントを音声で入力するためにマイクを使います。",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "抜き書きやコメントを音声で入力するためにマイクを使います。",
          "speechRecognitionPermission": "読み上げた内容を抜き書きやコメントへ文字入力するために音声認識を使います。",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9a91c937-2890-431c-a583-30ed11eb9fd3"
      }
    }
  }
}
